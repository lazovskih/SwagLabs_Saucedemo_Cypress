  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/lazovskih/SwagLabs_Saucedemo_Cypress/issues"
  },
  "homepage": "https://github.com/lazovskih/SwagLabs_Saucedemo_Cypress#readme",
  "devDependencies": {
    "cypress": "^16.1.0",
    "dotenv": "^17.2.2",
    "typescript": "^7.0.2"
  }
}
