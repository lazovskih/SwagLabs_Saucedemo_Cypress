{
  "name": "saucedemo_cypress",
  "version": "2.0.0",
  "description": "A demo end-to-end test automation project for the [SauceDemo](https://www.saucedemo.com) website — a simple e-commerce application designed specifically for testing practice. The project is built with [Cypress](https://cypress.io/) and TypeScript.",
  "main": "cypress.config.js",
  "scripts": {
    "cy:open": "cypress open",
    "cy:run": "cypress run",
    "cy:run:chrome": "cypress run --browser chrome --reporter-options reportDir=cypress/reports/chrome --config screenshotsFolder=cypress/screenshots/chrome,videosFolder=cypress/videos/chrome",
    "cy:run:firefox": "cypress run --browser firefox --reporter-options reportDir=cypress/reports/firefox --config screenshotsFolder=cypress/screenshots/firefox,videosFolder=cypress/videos/firefox",
    "cy:run:edge": "cypress run --browser edge --reporter-options reportDir=cypress/reports/edge --config screenshotsFolder=cypress/screenshots/edge,videosFolder=cypress/videos/edge",
    "cy:run:parallel": "concurrently --prefix \"[{name}]\" --names \"Chrome,Firefox,Edge\" --prefix-colors \"blue,magenta,cyan\" \"npm:cy:run:chrome\" \"npm:cy:run:firefox\" \"npm:cy:run:edge\"",
    "cy:run:all": "npm run cy:run:parallel",
    "cy:record:chrome": "cypress run --record --browser chrome --reporter-options reportDir=cypress/reports/chrome --config screenshotsFolder=cypress/screenshots/chrome,videosFolder=cypress/videos/chrome",
    "cy:record:firefox": "cypress run --record --browser firefox --reporter-options reportDir=cypress/reports/firefox --config screenshotsFolder=cypress/screenshots/firefox,videosFolder=cypress/videos/firefox",
    "cy:record:edge": "cypress run --record --browser edge --reporter-options reportDir=cypress/reports/edge --config screenshotsFolder=cypress/screenshots/edge,videosFolder=cypress/videos/edge",
    "cy:record:parallel": "concurrently --prefix \"[{name}]\" --names \"Chrome,Firefox,Edge\" --prefix-colors \"blue,magenta,cyan\" \"npm:cy:record:chrome\" \"npm:cy:record:firefox\" \"npm:cy:record:edge\"",
    "cy:open:chrome": "npx cypress open --e2e --browser chrome",
    "cy:open:firefox": "npx cypress open --e2e --browser firefox",
    "cy:open:edge": "npx cypress open --e2e --browser edge",
    "typecheck": "tsc --noEmit",
    "prepare": "husky",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix"
  },
  "lint-staged": {
    "*.{ts,mts,js,mjs}": [
      "eslint --max-warnings=0"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lazovskih/SwagLabs_Saucedemo_Cypress.git"
  },
  "keywords": [
    "SwagLabs",
    "Saucedemo",
    "Cypress",
    "automation",
    "TypeScript",
    "Page Object Model"
  ],
  "author": "Vitaly L",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/lazovskih/SwagLabs_Saucedemo_Cypress/issues"
  },
  "homepage": "https://github.com/lazovskih/SwagLabs_Saucedemo_Cypress#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "concurrently": "^10.0.6",
    "cypress": "^16.1.0",
    "cypress-mochawesome-reporter": "^5.0.0",
    "dotenv": "^17.2.2",
    "eslint": "^10.13.0",
    "eslint-plugin-cypress": "^7.0.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "typescript": "~5.8.0",
    "typescript-eslint": "^8.72.0"
  }
}
